# syntax=docker/dockerfile:1

# Multi-arch digest for quay.io/podman/stable:v6.1.3-immutable.
# Update deliberately; do not replace it with a floating tag.
FROM quay.io/podman/stable:v6.1.3-immutable@sha256:4cc31850c189386faca95d72988fe9573b3df06360cb65aea3ff5b17a04d0454

ARG OPENCODE_VERSION=2.4.1
ARG STARSHIP_VERSION=1.27.0
ARG TARGETARCH=amd64

USER root

# The base image already contains Podman, fuse-overlayfs, Git and a "podman"
# user (UID/GID 1000), with subordinate IDs suitable for nested rootless use.
RUN dnf -y install \
      alsa-utils \
      bash-completion \
      ca-certificates \
      curl \
      dejavu-sans-fonts \
      dejavu-sans-mono-fonts \
      dejavu-serif-fonts \
      distrobox \
      fd-find \
      findutils \
      fish \
      fontconfig \
      foot \
      gcc \
      gcc-c++ \
      git \
      glibc-langpack-en \
      jq \
      less \
      make \
      mesa-dri-drivers \
      mesa-libEGL \
      mesa-libGL \
      mesa-vulkan-drivers \
      nano \
      nodejs \
      npm \
      openssh-clients \
      openssl \
      pipewire \
      pipewire-pulseaudio \
      pipewire-utils \
      pkgconf-pkg-config \
      podman-compose \
      procps-ng \
      pulseaudio-utils \
      python3 \
      python3-pip \
      ripgrep \
      tar \
      tinyproxy \
      unzip \
      util-linux \
      wayland-utils \
      which \
      xdg-utils \
      xdpyinfo \
      xeyes \
      zip \
      --exclude=container-selinux \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/log/dnf* /var/log/yum.*

# Install the official glibc CLI, never via "curl | bash". Both architecture
# checksums come from the immutable v2.4.1 GitHub release.
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) \
        asset="opencode-linux-x64-baseline.tar.gz"; \
        checksum="9ddd18e3faf64eaeccf6a0fcbc96a5c7a14520ae5fd5b61e5be51d894f478b47" \
        ;; \
      arm64) \
        asset="opencode-linux-arm64.tar.gz"; \
        checksum="cb28cf94541aeb62a4b2ea5997a99b5dd6bae595a772f36fbe279299f2032a4f" \
        ;; \
      *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl --proto '=https' --tlsv1.2 -fL \
      "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/${asset}" \
      -o "/tmp/${asset}"; \
    echo "${checksum}  /tmp/${asset}" | sha256sum -c -; \
    tar -xzf "/tmp/${asset}" -C /usr/local/bin opencode; \
    chmod 0755 /usr/local/bin/opencode; \
    opencode --version; \
    rm -f "/tmp/${asset}"

# Starship is not packaged by Fedora. Static musl build from the official
# release; checksums match the .sha256 files published with v1.27.0.
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) \
        asset="starship-x86_64-unknown-linux-musl.tar.gz"; \
        checksum="10c8eb4cb3b761d9bf59ea828444c2dab36c900b7d69a69e08814b286969df89" \
        ;; \
      arm64) \
        asset="starship-aarch64-unknown-linux-musl.tar.gz"; \
        checksum="341f5cbf24699fa0b27ec88965ad25f862ea09e15d35a543fd6ffdff1d2aa00d" \
        ;; \
      *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl --proto '=https' --tlsv1.2 -fL \
      "https://github.com/starship/starship/releases/download/v${STARSHIP_VERSION}/${asset}" \
      -o "/tmp/${asset}"; \
    echo "${checksum}  /tmp/${asset}" | sha256sum -c -; \
    tar -xzf "/tmp/${asset}" -C /usr/local/bin starship; \
    chmod 0755 /usr/local/bin/starship; \
    starship --version; \
    # Plain-symbol preset: renders in any host terminal, no Nerd Font needed.
    starship preset no-nerd-font -o /etc/starship.toml; \
    chmod 0644 /etc/starship.toml; \
    rm -f "/tmp/${asset}"; \
    # Interactive shell inside the sandbox is fish, whatever the host uses.
    usermod --shell /usr/bin/fish podman

COPY --chmod=0755 scripts/entrypoint.sh /usr/local/bin/sandbox-entrypoint
COPY --chmod=0755 scripts/healthcheck.sh /usr/local/bin/sandbox-healthcheck
COPY --chmod=0755 scripts/verify.sh /usr/local/bin/sandbox-verify
COPY --chmod=0755 scripts/distrobox-podman.sh /usr/local/libexec/sandbox/distrobox-bin/podman
COPY --chmod=0755 scripts/distrobox-wrapper.sh /usr/local/libexec/sandbox/distrobox-wrapper
COPY --chmod=0755 scripts/distrobox-init-hook.sh /usr/local/libexec/sandbox/distrobox-init-hook
COPY --chmod=0644 config/distrobox.conf /etc/distrobox/distrobox.conf
# Host-side distrobox commands go through the wrapper (see the scripts).
# distrobox-init/-export/-host-exec run inside the distrobox and stay as is.
RUN for cmd in distrobox distrobox-assemble distrobox-create distrobox-enter \
        distrobox-ephemeral distrobox-generate-entry distrobox-list distrobox-rm \
        distrobox-stop distrobox-upgrade; do \
      ln -s /usr/local/libexec/sandbox/distrobox-wrapper "/usr/local/bin/${cmd}"; \
    done
COPY --chmod=0644 config/opencode/opencode.jsonc /etc/opencode/opencode.jsonc
COPY --chmod=0644 AGENTS.md /etc/opencode/instructions/AGENTS.md
COPY --chmod=0644 docs/OPENCODE.md /etc/opencode/instructions/OPENCODE.md
COPY --chmod=0644 docs/SECURITY.md /etc/opencode/instructions/SECURITY.md
COPY --chmod=0644 .opencode/agents /etc/opencode/agents
COPY --chmod=0644 .opencode/commands /etc/opencode/commands
COPY --chmod=0644 config/gitconfig /etc/gitconfig
COPY --chmod=0644 config/bashrc.sh /etc/profile.d/sandbox.sh
COPY --chmod=0644 config/sandbox.fish /etc/fish/conf.d/sandbox.fish
# Egress proxy policy, used by the separate egress-proxy service. Baked into
# the image: edits in the agent container never reach the proxy container.
COPY --chmod=0644 config/egress/tinyproxy.conf /etc/tinyproxy/sandbox.conf
COPY --chmod=0644 config/egress/allowlist.txt /etc/tinyproxy/allowlist.txt

ENV HOME=/home/podman \
    XDG_CONFIG_HOME=/home/podman/.config \
    XDG_DATA_HOME=/home/podman/.local/share \
    XDG_CACHE_HOME=/home/podman/.cache \
    XDG_RUNTIME_DIR=/run/user/1000 \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    TERM=xterm-256color \
    COLORTERM=truecolor \
    BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 \
    OPENCODE_DISABLE_CLAUDE_CODE=1

RUN mkdir -p /workspace \
        /run/user/1000/containers \
        /run/user/1000/pulse \
        /home/podman/.config/opencode \
        /home/podman/.local/share/opencode \
        /home/podman/.local/share/containers \
        /home/podman/.cache/opencode \
    && chown -R 1000:1000 /workspace /home/podman /run/user/1000 \
    && chmod 0700 /run/user/1000

WORKDIR /workspace
USER 1000:1000
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/sandbox-entrypoint"]
CMD ["sleep", "infinity"]

{
  "$schema": "https://opencode.ai/config.json",

  // Managed image settings. User projects cannot re-enable these scalars.
  "update": "disable",
  "share": "disabled",
  "automations": false,
  "default_agent": "build",
  "instructions": [
    "/etc/opencode/instructions/AGENTS.md",
    "/etc/opencode/instructions/OPENCODE.md",
    "/etc/opencode/instructions/SECURITY.md"
  ],
  "watcher": {
    "ignore": [
      ".sandbox-write-test.*"
    ]
  },

  "permissions": [
    // Only the selected user workspace is available to agents.
    { "action": "external_directory", "resource": "*", "effect": "deny" },

    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    // Diffs and log output can contain secrets tracked by Git.
    { "action": "shell", "resource": "git diff *", "effect": "ask" },
    { "action": "shell", "resource": "git log *", "effect": "ask" },
    { "action": "shell", "resource": "git show *", "effect": "ask" },
    { "action": "shell", "resource": "sandbox-verify *", "effect": "ask" },

    // These destructive/authority-changing operations stay unavailable even
    // with --auto. Routine Podman use is still possible with confirmation.
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "doas *", "effect": "deny" },
    { "action": "shell", "resource": "su *", "effect": "deny" },
    { "action": "shell", "resource": "podman system reset *", "effect": "deny" },

    // Shell commands must not become a shortcut around sensitive-file rules.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    // The grep permission matches the expression, not the searched path.
    { "action": "grep", "resource": "*", "effect": "ask" },
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "ask" },
    { "action": "skill", "resource": "*", "effect": "ask" }
  ],

  "agents": {
    // Keep these rules scoped to build. Global allow rules would weaken the
    // built-in read-only plan/explore agents and the no-subagent general agent.
    "build": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*.env", "effect": "deny" },
        { "action": "edit", "resource": "*.env.*", "effect": "deny" },
        { "action": "edit", "resource": ".env.example", "effect": "allow" },
        { "action": "edit", "resource": "opencode.jsonc", "effect": "ask" },
        { "action": "edit", "resource": "AGENTS.md", "effect": "ask" },
        { "action": "edit", "resource": ".opencode/**", "effect": "ask" },

        { "action": "subagent", "resource": "*", "effect": "ask" },
        { "action": "subagent", "resource": "reviewer", "effect": "allow" },
        { "action": "subagent", "resource": "security-reviewer", "effect": "allow" },
        { "action": "subagent", "resource": "explore", "effect": "allow" }
      ]
    }
  },

  "policies": [
    // Policies run after agent rules and saved approvals. Unlike permissions,
    // an agent's later read:"*" allow cannot reopen these sensitive paths.
    { "action": "tool.use", "resource": "external_directory:*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.example", "effect": "allow" },
    { "action": "tool.use", "resource": "read:*.pem", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.key", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*id_rsa*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*id_ed25519*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env.example", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:git push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sudo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:doas *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:podman system reset *", "effect": "deny" }
  ]
}

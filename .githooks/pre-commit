#!/usr/bin/env bash
# Bloqueia commits que incluam chaves, tokens ou arquivos sensíveis.
# Ativação (uma vez por clone): git config core.hooksPath .githooks
set -euo pipefail

fail() {
    printf '\n\033[1;31mpre-commit: commit bloqueado.\033[0m %s\n' "$1" >&2
    printf 'Remova o segredo do stage (git restore --staged <arquivo>) e revogue a chave se ela já foi exposta.\n' >&2
    printf 'Falso positivo? Acrescente o comentário "gitleaks:allow" na linha e explique no commit.\n\n' >&2
    exit 1
}

# 1. Preferir o gitleaks quando instalado: cobre centenas de formatos de chave.
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --pre-commit --staged --redact --no-banner \
        || fail "o gitleaks encontrou possíveis segredos (detalhes acima)."
else
    printf 'pre-commit: gitleaks não encontrado; usando a verificação básica embutida.\n' >&2
fi

# 2. Verificação embutida (sempre executada, não depende de ferramentas externas).
# SECRET_SCAN_BASE permite comparar com outra base; o CI usa a árvore vazia
# (4b825dc642cb6eb9a060e54bf8d69288fbee4904) para varrer o repositório inteiro.
base=()
if [[ -n "${SECRET_SCAN_BASE:-}" ]]; then
    base=("${SECRET_SCAN_BASE}")
fi

# 2a. Nomes de arquivo que quase sempre contêm credenciais.
blocked_files="$(git diff --cached --name-only --diff-filter=ACMR "${base[@]}" | grep -iE \
    '(^|/)\.env(\..+)?$|\.(pem|key|p12|pfx|jks|keystore|ppk|kdbx|asc|gpg)$|(^|/)id_(rsa|dsa|ecdsa|ed25519)(\.pub)?$|(^|/)\.(npmrc|pypirc|netrc|git-credentials|htpasswd)$|(^|/)credentials(\.json)?$|(^|/)(secrets?(\.[^/]*)?|service[-_]account[^/]*)\.(json|ya?ml|toml)$|\.tfvars$|\.tfstate(\.backup)?$' \
    | grep -viE '(^|/)\.env\.example$' || true)"
if [[ -n "${blocked_files}" ]]; then
    fail "arquivos sensíveis no stage:
${blocked_files}"
fi

# 2b. Conteúdo adicionado com formato de chave conhecida.
patterns=(
    '-----BEGIN ([A-Z]+ )*PRIVATE KEY( BLOCK)?-----'
    '(AKIA|ASIA)[0-9A-Z]{16}'
    'gh[pousr]_[A-Za-z0-9]{36,}'
    'github_pat_[A-Za-z0-9_]{40,}'
    'glpat-[A-Za-z0-9_-]{20,}'
    'sk-(ant-|proj-)?[A-Za-z0-9_-]{20,}'
    'AIza[0-9A-Za-z_-]{35}'
    'xox[abposr]-[A-Za-z0-9-]{10,}'
    'npm_[A-Za-z0-9]{36}'
    '(sk|rk)_live_[A-Za-z0-9]{20,}'
    'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'
    '://[^/[:space:]:@]+:[^/[:space:]@]{3,}@'
    '(api[_-]?key|secret|token|passw(or)?d|client[_-]?secret)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"'[:space:]$<{]{12,}["'"'"']'
)
regex="$(IFS='|'; printf '%s' "${patterns[*]}")"

hits="$(git diff --cached -U0 --no-color --no-ext-diff --diff-filter=ACMR "${base[@]}" \
    | awk '/^\+\+\+ /{file=substr($0,7); next} /^\+/{print file": "substr($0,2)}' \
    | grep -iE -- "${regex}" | grep -v 'gitleaks:allow' || true)"
if [[ -n "${hits}" ]]; then
    # Nunca imprimir o segredo: o trecho detectado é mascarado (terminal e logs de CI).
    fail "possíveis segredos nas linhas adicionadas:
$(printf '%s\n' "${hits}" | sed -E "s#${regex}#[REDIGIDO]#Ig" | cut -c1-100)"
fi

exit 0
